PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=historyczne_fiszki
DB_CONNECTION_LIMIT=10

# Leave empty to allow all origins in local development.
# For production provide comma-separated values, e.g.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Requests per 15 minutes for /api/*
RATE_LIMIT_MAX=300

# Authentication settings
JWT_SECRET=super_tajne_haslo_min_32_znaki
JWT_EXPIRES_IN=24h
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
